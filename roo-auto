#!/bin/bash
# Roo Orchestrator Wrapper Script - MANUAL RUNBOOK VERSION

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ORCHESTRATOR="$SCRIPT_DIR/roo-orchestrator-auto.py"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

function print_usage() {
    cat << EOF
${BLUE}Roo Orchestrator CLI - MANUAL RUNBOOK VERSION${NC}

Usage: roo-auto <command> [options]

Commands:
    ${GREEN}Execution Commands:${NC}
    start <jira-id> <type>       Start new manual task
    continue <jira-id>           Continue existing task
    run <jira-id> <phase>        Run specific phase

    ${GREEN}Management Commands:${NC}
    status <jira-id>             Show task status
    reset <jira-id>              Reset task state
    list                         List all active tasks

    ${GREEN}Utility Commands:${NC}
    help                         Show this help
    config                       Show current configuration
    test                         Test local setup

Task Types:
    feature    - Feature development (6 phases)
    bug        - Bug fix (5 phases)
    spike      - Research spike (4 phases)

Examples:
    roo-auto start PROJ-123 feature
    roo-auto continue PROJ-123
    roo-auto run PROJ-123 implementation
    roo-auto status PROJ-123

Environment Variables:
    ROO_WORKSPACE        Workspace directory (default: current directory)
    ROO_MAX_TOKENS       Your maxTokens setting (default: 8192)

EOF
}

function check_orchestrator() {
    if [[ ! -f "$ORCHESTRATOR" ]]; then
        echo -e "${RED}Error: roo-orchestrator-auto.py not found at $ORCHESTRATOR${NC}"
        exit 1
    fi
}

function cmd_start() {
    local jira_id="$1"
    local task_type="$2"

    if [[ -z "$jira_id" ]] || [[ -z "$task_type" ]]; then
        echo -e "${RED}Error: jira-id and type required${NC}"
        echo "Usage: roo-auto start <jira-id> <type>"
        exit 1
    fi

    echo -e "${GREEN}🚀 Starting MANUAL runbook execution${NC}"
    echo -e "${BLUE}Task: $jira_id${NC}"
    echo -e "${BLUE}Type: $task_type${NC}"
    echo ""

    python3 "$ORCHESTRATOR" \
        --jira "$jira_id" \
        --type "$task_type" \
        --max-tokens "${ROO_MAX_TOKENS:-8192}" \
        ${ROO_WORKSPACE:+--workspace "$ROO_WORKSPACE"}
}

function cmd_continue() {
    local jira_id="$1"

    if [[ -z "$jira_id" ]]; then
        echo -e "${RED}Error: jira-id required${NC}"
        echo "Usage: roo-auto continue <jira-id>"
        exit 1
    fi

    echo -e "${GREEN}▶️  Continuing task: $jira_id${NC}"
    echo ""

    python3 "$ORCHESTRATOR" \
        --jira "$jira_id" \
        --max-tokens "${ROO_MAX_TOKENS:-8192}" \
        ${ROO_WORKSPACE:+--workspace "$ROO_WORKSPACE"}
}

function cmd_run() {
    local jira_id="$1"
    local phase="$2"

    if [[ -z "$jira_id" ]] || [[ -z "$phase" ]]; then
        echo -e "${RED}Error: jira-id and phase required${NC}"
        echo "Usage: roo-auto run <jira-id> <phase>"
        exit 1
    fi

    echo -e "${GREEN}▶️  Running phase '$phase' for: $jira_id${NC}"
    echo ""

    python3 "$ORCHESTRATOR" \
        --jira "$jira_id" \
        --phase "$phase" \
        --max-tokens "${ROO_MAX_TOKENS:-8192}" \
        ${ROO_WORKSPACE:+--workspace "$ROO_WORKSPACE"}
}

function cmd_status() {
    local jira_id="$1"

    if [[ -z "$jira_id" ]]; then
        echo -e "${RED}Error: jira-id required${NC}"
        echo "Usage: roo-auto status <jira-id>"
        exit 1
    fi

    python3 "$ORCHESTRATOR" \
        --jira "$jira_id" \
        --status \
        ${ROO_WORKSPACE:+--workspace "$ROO_WORKSPACE"}
}

function cmd_reset() {
    local jira_id="$1"

    if [[ -z "$jira_id" ]]; then
        echo -e "${RED}Error: jira-id required${NC}"
        echo "Usage: roo-auto reset <jira-id>"
        exit 1
    fi

    echo -e "${YELLOW}⚠️  Resetting task: $jira_id${NC}"
    read -p "Are you sure? This will delete all progress (y/N): " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        python3 "$ORCHESTRATOR" \
            --jira "$jira_id" \
            --reset \
            ${ROO_WORKSPACE:+--workspace "$ROO_WORKSPACE"}
    else
        echo "Cancelled"
    fi
}

function cmd_list() {
    local workspace="${ROO_WORKSPACE:-.}"
    echo -e "${BLUE}🤖 Active Manual Orchestrator Tasks:${NC}\n"

    if ! ls "$workspace"/.roo-state-*.json 1> /dev/null 2>&1; then
        echo "No active tasks found"
        exit 0
    fi

    for state_file in "$workspace"/.roo-state-*.json; do
        if [[ -f "$state_file" ]]; then
            local jira_id
            jira_id=$(basename "$state_file" | sed 's/^\.roo-state-//; s/\.json$//')
            local task_type
            task_type=$(python3 -c "import json; print(json.load(open('$state_file'))['task_type'])" 2>/dev/null || echo "unknown")
            local completed
            completed=$(python3 -c "import json; print(len(json.load(open('$state_file'))['phases_completed']))" 2>/dev/null || echo "0")

            echo -e "${GREEN}$jira_id${NC} ($task_type)"
            echo "  Progress: $completed phases completed"
            echo "  Last execution: manual"
            echo "  State file: $state_file"
            echo ""
        fi
    done
}

function cmd_config() {
    echo -e "${BLUE}Current Configuration:${NC}\n"
    echo "Workspace:      ${ROO_WORKSPACE:-.}"
    echo "Max Tokens:     ${ROO_MAX_TOKENS:-8192}"
    echo "Execution Mode: manual"
    echo ""
    echo -e "${YELLOW}To change these, set environment variables:${NC}"
    echo "export ROO_WORKSPACE=/path/to/workspace"
    echo "export ROO_MAX_TOKENS=8192"
}

function cmd_test() {
    echo -e "${BLUE}🧪 Testing Manual Setup...${NC}\n"

    echo -n "Python 3: "
    if command -v python3 &> /dev/null; then
        echo -e "${GREEN}✓ Found$(python3 --version)${NC}"
    else
        echo -e "${RED}✗ Not found${NC}"
    fi

    echo -n "Orchestrator: "
    if [[ -f "$ORCHESTRATOR" ]]; then
        echo -e "${GREEN}✓ Found${NC}"
    else
        echo -e "${RED}✗ Not found at $ORCHESTRATOR${NC}"
    fi

    echo ""
    echo -e "${BLUE}Recommended Setup:${NC}"
    echo "  ✓ Python 3"
    echo "  ✓ Orchestrator script"
    echo "  ✓ IDE plugin (Roo/Codex) for manual phase execution"
}

check_orchestrator

COMMAND="${1:-help}"
shift || true

case "$COMMAND" in
    start)
        cmd_start "$@"
        ;;
    continue|cont|resume)
        cmd_continue "$@"
        ;;
    run|phase)
        cmd_run "$@"
        ;;
    status|st)
        cmd_status "$@"
        ;;
    reset)
        cmd_reset "$@"
        ;;
    list|ls)
        cmd_list
        ;;
    config|cfg)
        cmd_config
        ;;
    test)
        cmd_test
        ;;
    help|--help|-h)
        print_usage
        ;;
    *)
        echo -e "${RED}Unknown command: $COMMAND${NC}\n"
        print_usage
        exit 1
        ;;
esac
