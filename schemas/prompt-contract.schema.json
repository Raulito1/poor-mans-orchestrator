{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PromptContract",
  "type": "object",
  "required": [
    "role",
    "objective",
    "inputs",
    "constraints",
    "allowed_actions",
    "output_requirements",
    "fallback"
  ],
  "properties": {
    "role": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "allowed_actions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "output_requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "fallback": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
